---
import BaseLayout from "../layouts/BaseLayout.astro";
import DitherBg from "./DitherBg.svelte";
import DitherCover from "./DitherCover.svelte";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import WireCard from "./WireCard.astro";
import { agentSkills } from "../lib/data/agent-skills";
import { resolveLocale, useTranslations } from "../i18n";

const { lang = "en" } = Astro.props;
const locale = resolveLocale(lang);
const t = useTranslations(locale);
const l = locale;
const groups = ["products", "ecdsa-fail", "cs-brasil", "portfolio", "general"] as const;
const groupNames = { products: t.skills.groups.products, "ecdsa-fail": t.skills.groups.ecdsaFail, "cs-brasil": t.skills.groups.csBrasil, portfolio: t.skills.groups.portfolio, general: t.skills.groups.general };
const statusNames = t.skills.statuses;
const base = locale === "pt" ? "/pt" : "";
const filters = ["all", ...groups] as const;
const filterNames = { all: t.skills.filter.all, products: t.skills.filter.products, "ecdsa-fail": t.skills.filter.ecdsaFail, "cs-brasil": t.skills.filter.csBrasil, portfolio: t.skills.filter.portfolio, general: t.skills.filter.general };
const filterCount = (filter: typeof filters[number]) => filter === "all"
  ? agentSkills.length
  : agentSkills.filter((skill) => skill.scope === filter).length;

const classifications: Record<string, { en: string; pt: string }> = {
  "ralph-starter-orchestration": { en: "orchestration", pt: "orquestração" },
  "autoresearch-benchmark-loop": { en: "autonomous research", pt: "pesquisa autônoma" },
  "aeo-delivery-system": { en: "AI discovery", pt: "descoberta por IA" },
  "benchmark-frontier-archaeology": { en: "frontier analysis", pt: "análise de fronteira" },
  "ecdsa-route-spec": { en: "research specification", pt: "especificação de pesquisa" },
  "circuit-engineer-factory": { en: "worker orchestration", pt: "orquestração de workers" },
  "circuit-optimization": { en: "circuit engineering", pt: "engenharia de circuitos" },
  "reversible-circuit-validation": { en: "correctness", pt: "correção" },
  "peak-qubit-reduction": { en: "space optimization", pt: "otimização de espaço" },
  "toffoli-reduction": { en: "gate optimization", pt: "otimização de gates" },
  "island-hunting": { en: "GPU research", pt: "pesquisa em GPU" },
  "multi-agent-research-collaboration": { en: "collaboration", pt: "colaboração" },
  "csbrasil-content-pipeline": { en: "content pipeline", pt: "pipeline de conteúdo" },
  "faction-pipeline": { en: "game production", pt: "produção de jogo" },
  "asset-review": { en: "visual review", pt: "revisão visual" },
  regua: { en: "evaluation", pt: "avaliação" },
  "csbrasil-pr-triage": { en: "release risk", pt: "risco de release" },
  "csbrasil-smoke-check": { en: "playable QA", pt: "QA jogável" },
  "gauntlet-fps": { en: "visual QA", pt: "QA visual" },
  "bug-hunt": { en: "debugging", pt: "debugging" },
  "blog-voice": { en: "editorial", pt: "editorial" },
  "bilingual-publishing": { en: "publishing", pt: "publicação" },
  "portfolio-cover-system": { en: "visual system", pt: "sistema visual" },
  "frontend-delivery-harness": { en: "frontend delivery", pt: "entrega frontend" },
  "portfolio-mcp": { en: "agent interface", pt: "interface para agents" },
};
const classificationFor = (slug: string) => classifications[slug] ?? { en: "operating method", pt: "método operacional" };
const csAuthoredTotal = agentSkills.filter((skill) => skill.scope === "cs-brasil").length;
---

<BaseLayout
  lang={locale === "pt" ? "pt-br" : "en"}
  title={t.skills.title}
  description={t.skills.description}
>
  <DitherBg client:load opacity={0.45} />
  <Section id="skills" pageHeader tight>
    <SectionHeader
      level={1}
      index="02"
      overline="Agent Skills"
      title={t.skills.intro.title}
      description={t.skills.intro.description}
    />

    <a
      class="agent-ready-proof"
      href={`${base}/connect`}
      data-reveal
      data-track="agent_connect"
      data-track-location="skills_intro"
    >
      <div class="agent-ready-proof__copy">
        <span class="agent-ready-proof__motto"><i aria-hidden="true"></i> AGENT-READY · HUMANS WELCOME</span>
        <h2>{t.skills.proof.title}</h2>
        <p>{t.skills.proof.description}</p>
      </div>
      <div class="agent-ready-proof__protocols" aria-label={t.skills.proof.capabilities}>
        <span>MCP</span>
        <span>Agent Skills</span>
        <span>OpenAPI</span>
        <code>/api/mcp ↗</code>
      </div>
    </a>

    <div class="skills-overview" data-reveal>
      <div class="skills-stat" data-reveal-item>
        <strong>{agentSkills.length}</strong>
        <span>{t.skills.stats.methods}</span>
      </div>
      <div class="skills-stat" data-reveal-item>
        <strong>{csAuthoredTotal}</strong>
        <span>{t.skills.stats.csBrasil}</span>
      </div>
      <div class="skills-stat" data-reveal-item>
        <strong>45</strong>
        <span><code>/game</code> · {t.skills.stats.game}</span>
      </div>
      <div class="skills-stat" data-reveal-item>
        <strong>45</strong>
        <span><code>/game2</code> · {t.skills.stats.game2}</span>
      </div>
    </div>
    <p class="skills-inventory-note">
      {t.skills.stats.inventory}
    </p>

    <div class="skills-browser" data-skill-root>
      <div class="skill-filters" role="group" aria-label={t.skills.filter.label}>
        {filters.map((filter) => (
          <button
            type="button"
            class="skill-filter"
            data-skill-filter={filter}
            aria-pressed={filter === "all" ? "true" : "false"}
          >
            <span>{filterNames[filter]}</span>
            <strong>{filterCount(filter)}</strong>
          </button>
        ))}
      </div>
      <p class="skill-filter-status" data-skill-status data-status-template={t.skills.filter.showing(Number.NaN)} aria-live="polite">
        {t.skills.filter.showing(agentSkills.length)}
      </p>

      <ul class="skill-list" data-reveal>
        {agentSkills.map((skill, index) => {
          const classification = classificationFor(skill.slug);
          return (
            <li class="skill-item" data-skill-item data-scope={skill.scope} data-reveal-item>
              <WireCard class="skill-card" glyph={String(index + 1).padStart(2, "0")}>
                <div class="skill-inner">
                  <DitherCover
                    client:visible
                    src={skill.thumbnail}
                    seed={skill.name}
                    alt={`${t.skills.fields.thumbnail}: ${skill.name}`}
                    class="skill-cover"
                    invert
                  />
                  <article class="skill-body">
                    <header class="skill-card__head">
                      <span class="skill-card__category">
                        {classification[l]} · {groupNames[skill.scope]}
                      </span>
                      <span class={`skill-card__status skill-card__status--${skill.status}`}>{statusNames[skill.status]}</span>
                    </header>
                    <h2>{skill.name}</h2>
                    <p class="skill-card__summary">{skill.summary[l]}</p>
                    <dl>
                      <div><dt>{t.skills.fields.contract}</dt><dd>{skill.contract[l]}</dd></div>
                      <div><dt>{t.skills.fields.evidence}</dt><dd>{skill.evidence[l]}</dd></div>
                    </dl>
                    {(skill.article || skill.discoveryUrl) && (
                      <footer>
                        {skill.article && <a href={skill.article[l]}>{t.skills.fields.proof}</a>}
                        {skill.discoveryUrl && <a href={skill.discoveryUrl}>{t.skills.fields.source}</a>}
                      </footer>
                    )}
                  </article>
                </div>
              </WireCard>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="skills-cta">
      <p>{t.skills.fields.cta}</p>
      <a class="btn btn-primary" href={`${base}/contact?subject=ai-product-systems`} data-track="contact_view" data-track-location="skills_bottom">{t.skills.fields.startProject}</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .agent-ready-proof {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid rgba(45, 107, 255, 0.28);
    border-radius: clamp(1rem, 2vw, 1.5rem);
    background: linear-gradient(110deg, rgba(45, 107, 255, 0.075), rgba(3, 6, 16, 0.82) 45%);
    color: var(--text);
    transition: border-color var(--duration-hover) var(--ease-default), background var(--duration-hover) var(--ease-default);
  }
  .agent-ready-proof:hover {
    border-color: rgba(45, 107, 255, 0.52);
    background: linear-gradient(110deg, rgba(45, 107, 255, 0.11), rgba(3, 6, 16, 0.9) 45%);
  }
  @media (min-width: 880px) {
    .agent-ready-proof { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
  }
  .agent-ready-proof__motto {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--accent-soft);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.12em;
  }
  .agent-ready-proof__motto i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px rgba(45, 107, 255, 0.85);
  }
  .agent-ready-proof h2 {
    max-width: 24ch;
    margin: 0.7rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    line-height: 1.1;
  }
  .agent-ready-proof p {
    max-width: 68ch;
    margin: 0.85rem 0 0;
    color: var(--muted);
    line-height: 1.6;
  }
  .agent-ready-proof__protocols {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .agent-ready-proof__protocols span,
  .agent-ready-proof__protocols code {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: 0.38rem 0.65rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    white-space: nowrap;
  }
  .agent-ready-proof__protocols code { color: var(--accent-soft); }
  .skills-overview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }
  @media (min-width: 860px) { .skills-overview { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .skills-stat {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 8.5rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: rgba(3, 6, 16, 0.74);
  }
  .skills-stat strong {
    color: var(--accent-soft);
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1;
  }
  .skills-stat span { color: var(--muted); font-family: var(--font-mono); font-size: 0.7rem; line-height: 1.45; }
  .skills-stat code { color: var(--text); }
  .skills-inventory-note { max-width: 84ch; margin-top: 1rem; color: var(--muted-soft); font-size: 0.78rem; line-height: 1.55; }
  .skills-browser { margin-top: 2.5rem; }
  .skill-filters { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .skill-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    background: rgba(3, 6, 16, 0.72);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    cursor: pointer;
    transition: color var(--duration-hover) var(--ease-default), border-color var(--duration-hover) var(--ease-default), background var(--duration-hover) var(--ease-default);
  }
  .skill-filter strong { color: var(--muted-soft); font-weight: 500; }
  .skill-filter[aria-pressed="true"] { border-color: rgba(45, 107, 255, 0.55); background: rgba(45, 107, 255, 0.09); color: var(--accent-soft); }
  .skill-filter[aria-pressed="true"] strong { color: var(--accent); }
  .skill-filter-status { margin: 1rem 0; color: var(--muted-soft); font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .skill-list { display: flex; flex-direction: column; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .skill-item[hidden] { display: none; }
  :global(.skill-card) { padding: 0; border-radius: clamp(1rem, 2vw, 1.5rem); background: rgba(3, 6, 16, 0.84); }
  .skill-inner { display: grid; grid-template-columns: 1fr; min-width: 0; }
  @media (min-width: 760px) { .skill-inner { grid-template-columns: minmax(230px, 30%) 1fr; } }
  :global(.skill-cover) { min-height: 220px; aspect-ratio: 16 / 8; border-radius: 0; }
  @media (min-width: 760px) { :global(.skill-cover) { height: 100%; min-height: 270px; aspect-ratio: auto; border-radius: 0; } }
  .skill-inner:hover :global(.dither-cover__dither) { opacity: 1; }
  .skill-body { min-width: 0; padding: clamp(1.3rem, 3vw, 2rem); }
  .skill-card__head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.6rem 1rem; }
  .skill-card__category, .skill-card__status, dt { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .skill-card__category { color: var(--muted-soft); }
  .skill-card__status { color: var(--muted); }
  .skill-card__status--public { color: var(--accent-soft); }
  .skill-body h2 { margin-top: 0.85rem; font-family: var(--font-display); font-size: clamp(1.45rem, 2.8vw, 2rem); line-height: 1.08; }
  .skill-card__summary { margin-top: 0.65rem; color: var(--text); line-height: 1.6; }
  .skill-body dl { display: grid; gap: 1rem; margin-top: 1.25rem; }
  @media (min-width: 1040px) { .skill-body dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .skill-body dl div { display: grid; align-content: start; gap: 0.35rem; }
  .skill-body dt { color: rgba(45, 107, 255, 0.62); }
  .skill-body dd { color: var(--muted); font-size: 0.86rem; line-height: 1.55; }
  .skill-body footer { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.3rem; }
  .skill-body footer a { color: var(--accent-soft); font-family: var(--font-mono); font-size: 0.72rem; }
  .skills-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--line); }
  .skills-cta p { color: var(--text); font-family: var(--font-display); font-size: clamp(1.25rem, 2vw, 1.8rem); }
</style>

<script>
  const initSkillFilters = () => {
    const root = document.querySelector<HTMLElement>("[data-skill-root]");
    if (!root || root.dataset.filtersReady === "true") return;
    root.dataset.filtersReady = "true";
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-skill-filter]"));
    const items = Array.from(root.querySelectorAll<HTMLElement>("[data-skill-item]"));
    const status = root.querySelector<HTMLElement>("[data-skill-status]");

    root.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-skill-filter]");
      if (!button) return;
      const filter = button.dataset.skillFilter ?? "all";
      let visible = 0;
      for (const item of items) {
        const show = filter === "all" || item.dataset.scope === filter;
        item.hidden = !show;
        if (show) visible += 1;
      }
      for (const candidate of buttons) candidate.setAttribute("aria-pressed", String(candidate === button));
      if (status) status.textContent = status.dataset.statusTemplate?.replace("NaN", String(visible)) ?? "";
    });
  };

  initSkillFilters();
  document.addEventListener("astro:page-load", initSkillFilters);
</script>
